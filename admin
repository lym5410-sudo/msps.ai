<script>

/* ==================================================
   API
================================================== */

const API_URL =
    "/.netlify/functions/manage-tools";


let adminPassword = "";

let tools = [];

let selectedCategory = "";

let editingId = null;


/* ==================================================
   登入
================================================== */

async function login() {

    const password =
        document
            .getElementById("passwordInput")
            .value
            .trim();


    if (!password) {

        showLoginError(
            "請輸入管理員密碼"
        );

        return;

    }


    try {

        const response =
            await fetch(
                API_URL,
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json",

                        "x-admin-password":
                            password

                    },

                    body:
                        JSON.stringify({

                            action: "login"

                        })

                }
            );


        const result =
            await response.json();


        if (
            !response.ok ||
            !result.success
        ) {

            showLoginError(
                result.message ||
                "登入失敗"
            );

            return;

        }


        adminPassword =
            password;


        document
            .getElementById("loginPage")
            .style.display = "none";


        document
            .getElementById("adminPage")
            .style.display = "block";


        loadTools();

    }

    catch (error) {

        console.error(error);

        showLoginError(
            "無法連接管理系統"
        );

    }

}


/* ==================================================
   登入錯誤
================================================== */

function showLoginError(message) {

    document
        .getElementById("loginError")
        .textContent =
        message;

}


/* ==================================================
   登出
================================================== */

function logout() {

    adminPassword = "";

    location.reload();

}


/* ==================================================
   選擇專區
================================================== */

function selectCategory(category) {

    selectedCategory =
        category;


    document
        .querySelectorAll(
            ".category-option"
        )
        .forEach(option => {

            option.classList.toggle(
                "active",
                option.dataset.category ===
                category
            );

        });


    document
        .getElementById("studentFields")
        .style.display =
        "none";


    document
        .getElementById("teacherFields")
        .style.display =
        "none";


    document
        .getElementById("infoFields")
        .style.display =
        "none";


    if (category === "學生") {

        document
            .getElementById("studentFields")
            .style.display =
            "block";

    }


    if (category === "教師") {

        document
            .getElementById("teacherFields")
            .style.display =
            "block";

    }


    if (category === "資訊工具") {

        document
            .getElementById("infoFields")
            .style.display =
            "block";

    }

}


/* ==================================================
   關鍵字
================================================== */

function parseKeywords(text) {

    return text

        .split(/[、,，]/)

        .map(
            item =>
                item.trim()
        )

        .filter(Boolean);

}


/* ==================================================
   取得表單資料
================================================== */

function getFormData() {

    const name =
        document
            .getElementById("name")
            .value
            .trim();


    const url =
        document
            .getElementById("url")
            .value
            .trim();


    const icon =
        document
            .getElementById("icon")
            .value
            .trim() ||
        "📚";


    const description =
        document
            .getElementById("description")
            .value
            .trim();


    if (!name) {

        throw new Error(
            "請輸入網站名稱"
        );

    }


    if (!url) {

        throw new Error(
            "請輸入網站網址"
        );

    }


    if (!selectedCategory) {

        throw new Error(
            "請選擇所屬專區"
        );

    }


    let type = "";

    let subject = "";

    let stage = "";

    let keywords = [];


    if (
        selectedCategory ===
        "學生"
    ) {

        type = "student";

        subject =
            document
                .getElementById(
                    "studentSubject"
                )
                .value;

        stage =
            document
                .getElementById(
                    "studentStage"
                )
                .value;

        keywords =
            parseKeywords(
                document
                    .getElementById(
                        "studentKeywords"
                    )
                    .value
            );

    }


    if (
        selectedCategory ===
        "教師"
    ) {

        type = "teacher";

        subject =
            document
                .getElementById(
                    "teacherSubject"
                )
                .value;

        stage =
            document
                .getElementById(
                    "teacherStage"
                )
                .value;

        keywords =
            parseKeywords(
                document
                    .getElementById(
                        "teacherKeywords"
                    )
                    .value
            );

    }


    if (
        selectedCategory ===
        "資訊工具"
    ) {

        type = "tool";

        subject =
            document
                .getElementById(
                    "infoType"
                )
                .value;

        stage = "";

        keywords =
            parseKeywords(
                document
                    .getElementById(
                        "infoKeywords"
                    )
                    .value
            );

    }


    return {

        name,

        url,

        type,

        category:
            selectedCategory,

        subject,

        stage,

        keywords,

        icon,

        description

    };

}


/* ==================================================
   新增
================================================== */

async function saveTool() {

    try {

        const data =
            getFormData();


        const response =
            await fetch(
                API_URL,
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json",

                        "x-admin-password":
                            adminPassword

                    },

                    body:
                        JSON.stringify(
                            data
                        )

                }
            );


        const result =
            await response.json();


        if (
            !response.ok ||
            !result.success
        ) {

            throw new Error(
                result.message ||
                "新增失敗"
            );

        }


        showMessage(
            "success",
            "🎉 工具新增成功！"
        );


        clearForm();

        await loadTools();

    }

    catch (error) {

        showMessage(
            "error",
            "❌ " +
            error.message
        );

    }

}


/* ==================================================
   編輯
================================================== */

function editTool(id) {

    const tool =
        tools.find(
            item =>
                String(item.id) ===
                String(id)
        );


    if (!tool) {

        alert(
            "找不到這個工具"
        );

        return;

    }


    editingId =
        tool.id;


    document
        .getElementById("formTitle")
        .textContent =
        "✏️ 編輯工具";


    document
        .getElementById("saveButton")
        .textContent =
        "💾 儲存修改";


    document
        .getElementById("cancelButton")
        .style.display =
        "block";


    document
        .getElementById("name")
        .value =
        tool.name || "";


    document
        .getElementById("url")
        .value =
        tool.url || "";


    document
        .getElementById("icon")
        .value =
        tool.icon || "📚";


    document
        .getElementById("description")
        .value =
        tool.description || "";


    selectCategory(
        tool.category ||
        "學生"
    );


    if (
        tool.category ===
        "學生"
    ) {

        document
            .getElementById(
                "studentSubject"
            )
            .value =
            tool.subject ||
            "國語文";


        document
            .getElementById(
                "studentStage"
            )
            .value =
            tool.stage ||
            "國小高年級";


        document
            .getElementById(
                "studentKeywords"
            )
            .value =
            (
                tool.keywords ||
                []
            ).join("、");

    }


    if (
        tool.category ===
        "教師"
    ) {

        document
            .getElementById(
                "teacherSubject"
            )
            .value =
            tool.subject ||
            "資訊";


        document
            .getElementById(
                "teacherStage"
            )
            .value =
            tool.stage ||
            "高年級";


        document
            .getElementById(
                "teacherKeywords"
            )
            .value =
            (
                tool.keywords ||
                []
            ).join("、");

    }


    if (
        tool.category ===
        "資訊工具"
    ) {

        document
            .getElementById(
                "infoType"
            )
            .value =
            tool.subject ||
            "AI工具";


        document
            .getElementById(
                "infoKeywords"
            )
            .value =
            (
                tool.keywords ||
                []
            ).join("、");

    }


    window.scrollTo({

        top: 0,

        behavior: "smooth"

    });

}


/* ==================================================
   儲存修改
================================================== */

async function updateTool() {

    try {

        const data =
            getFormData();


        data.id =
            editingId;


        const response =
            await fetch(
                API_URL,
                {

                    method: "PUT",

                    headers: {

                        "Content-Type":
                            "application/json",

                        "x-admin-password":
                            adminPassword

                    },

                    body:
                        JSON.stringify(
                            data
                        )

                }
            );


        const result =
            await response.json();


        if (
            !response.ok ||
            !result.success
        ) {

            throw new Error(
                result.message ||
                "修改失敗"
            );

        }


        showMessage(
            "success",
            "🎉 工具修改成功！"
        );


        cancelEdit();

        await loadTools();

    }

    catch (error) {

        showMessage(
            "error",
            "❌ " +
            error.message
        );

    }

}


/* ==================================================
   刪除
================================================== */

async function deleteTool(id) {

    const tool =
        tools.find(
            item =>
                String(item.id) ===
                String(id)
        );


    if (!tool) return;


    const yes =
        confirm(
            `確定要刪除「${tool.name}」嗎？`
        );


    if (!yes) return;


    try {

        const response =
            await fetch(
                API_URL,
                {

                    method: "DELETE",

                    headers: {

                        "Content-Type":
                            "application/json",

                        "x-admin-password":
                            adminPassword

                    },

                    body:
                        JSON.stringify({

                            id

                        })

                }
            );


        const result =
            await response.json();


        if (
            !response.ok ||
            !result.success
        ) {

            throw new Error(
                result.message ||
                "刪除失敗"
            );

        }


        showMessage(
            "success",
            "🗑️ 工具已刪除。"
        );


        await loadTools();

    }

    catch (error) {

        showMessage(
            "error",
            "❌ " +
            error.message
        );

    }

}


/* ==================================================
   載入工具
================================================== */

async function loadTools() {

    try {

        const response =
            await fetch(
                API_URL +
                "?t=" +
                Date.now()
            );


        const result =
            await response.json();


        if (
            !response.ok ||
            !result.success
        ) {

            throw new Error(
                result.message ||
                "讀取失敗"
            );

        }


        tools =
            Array.isArray(
                result.tools
            )
            ? result.tools
            : [];


        renderTools();

    }

    catch (error) {

        document
            .getElementById(
                "toolList"
            )
            .innerHTML =

            `
            <div style="
                color:#dc2626;
                padding:15px;
            ">
                ❌ ${escapeHtml(
                    error.message
                )}
            </div>
            `;

    }

}


/* ==================================================
   顯示工具
================================================== */

function renderTools() {

    const container =
        document.getElementById(
            "toolList"
        );


    if (!tools.length) {

        container.innerHTML =

            `
            <div style="
                color:#64748b;
                padding:20px;
                text-align:center;
            ">
                目前沒有工具。
            </div>
            `;

        return;

    }


    container.innerHTML =

        tools.map(tool => {

            const keywords =
                Array.isArray(
                    tool.keywords
                )
                ? tool.keywords.join(
                    "、"
                )
                : "";


            return `

                <div
                    class="tool-item"
                >

                    <div
                        class="tool-info"
                    >

                        <div
                            class="tool-icon"
                        >
                            ${escapeHtml(
                                tool.icon ||
                                "📚"
                            )}
                        </div>


                        <div>

                            <div
                                class="tool-name"
                            >
                                ${escapeHtml(
                                    tool.name
                                )}
                            </div>


                            <div
                                class="tool-meta"
                            >
                                ${escapeHtml(
                                    tool.category ||
                                    ""
                                )}

                                ／

                                ${escapeHtml(
                                    tool.subject ||
                                    ""
                                )}

                                ${tool.stage
                                    ? "／ " +
                                      escapeHtml(
                                          tool.stage
                                      )
                                    : ""
                                }
                            </div>


                            ${
                                keywords
                                ? `
                                <div
                                    class="tool-keywords"
                                >
                                    🔎 ${escapeHtml(
                                        keywords
                                    )}
                                </div>
                                `
                                : ""
                            }

                        </div>

                    </div>


                    <div
                        class="tool-actions"
                    >

                        <button
                            class="edit-btn"
                            onclick="editTool(
                                '${escapeJs(
                                    tool.id
                                )}'
                            )"
                        >
                            ✏️ 編輯
                        </button>


                        <button
                            class="delete-btn"
                            onclick="deleteTool(
                                '${escapeJs(
                                    tool.id
                                )}'
                            )"
                        >
                            🗑️ 刪除
                        </button>

                    </div>

                </div>

            `;

        }).join("");

}


/* ==================================================
   清除表單
================================================== */

