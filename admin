    document
        .getElementById("url")
        .value = "";


    document
        .getElementById("icon")
        .value = "📚";


    document
        .getElementById("description")
        .value = "";


    document
        .getElementById(
            "studentKeywords"
        )
        .value = "";


    document
        .getElementById(
            "teacherKeywords"
        )
        .value = "";


    document
        .getElementById(
            "infoKeywords"
        )
        .value = "";


