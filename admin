<!DOCTYPE html>
<html lang="zh-Hant">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>AI 教育工具中心｜管理後台</title>

<style>

* {
    box-sizing: border-box;
}

body {

    margin: 0;

    font-family:
        "Noto Sans TC",
        "Microsoft JhengHei",
        Arial,
        sans-serif;

    background:
        linear-gradient(
            135deg,
            #eef2ff,
            #f8fafc
        );

    color: #1e293b;

    min-height: 100vh;
}


/* =========================
   登入
========================= */

.login-page {

    min-height: 100vh;

    display: flex;

    justify-content: center;

    align-items: center;

    padding: 20px;
}


.login-box {

    width: 100%;

    max-width: 420px;

    background: white;

    border-radius: 24px;

    padding: 40px;

    box-shadow:
        0 20px 60px
        rgba(15,23,42,0.15);

    text-align: center;
}


.login-icon {

    font-size: 60px;

    margin-bottom: 10px;
}


.login-box h1 {

    margin: 0;

    font-size: 28px;
}


.login-box p {

    color: #64748b;

    margin-bottom: 28px;
}


input,
select,
textarea {

    width: 100%;

    padding: 13px 15px;

    border:
        1px solid #cbd5e1;

    border-radius: 12px;

    font-size: 15px;

    outline: none;

    font-family: inherit;

    transition: 0.2s;
}


input:focus,
select:focus,
textarea:focus {

    border-color: #6366f1;

    box-shadow:
        0 0 0 3px
        rgba(99,102,241,0.12);
}


button {

    border: none;

    cursor: pointer;

    font-family: inherit;
}


.primary-btn {

    width: 100%;

    padding: 14px;

    margin-top: 15px;

    border-radius: 12px;

    background:
        linear-gradient(
            135deg,
            #4f46e5,
            #7c3aed
        );

    color: white;

    font-size: 16px;

    font-weight: 800;
}


.primary-btn:hover {

    opacity: 0.9;

}


.login-error {

    color: #dc2626;

    margin-top: 15px;

    font-size: 14px;
}


/* =========================
   後台
========================= */

.admin-page {

    display: none;

    min-height: 100vh;
}


header {

    background:
        linear-gradient(
            135deg,
            #312e81,
            #4f46e5,
            #7c3aed
        );

    color: white;

    padding: 28px 20px;
}


.header-inner {

    max-width: 1100px;

    margin: auto;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;
}


header h1 {

    margin: 0;

    font-size: 25px;
}


header p {

    margin: 6px 0 0;

    opacity: 0.85;
}


.logout-btn {

    background:
        rgba(255,255,255,0.15);

    color: white;

    padding: 10px 16px;

    border-radius: 10px;

    font-weight: 700;
}


main {

    max-width: 1100px;

    margin: auto;

    padding: 35px 20px 60px;
}


/* =========================
   區塊
========================= */

.section {

    background: white;

    border-radius: 20px;

    padding: 26px;

    margin-bottom: 25px;

    box-shadow:
        0 8px 30px
        rgba(15,23,42,0.07);
}


.section h2 {

    margin-top: 0;

    margin-bottom: 22px;
}


/* =========================
   表單
========================= */

.form-grid {

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 18px;
}


.form-group {

    display: flex;

    flex-direction: column;

    gap: 7px;
}


.full {

    grid-column: 1 / -1;
}


label {

    font-weight: 800;

    font-size: 14px;
}


.required {

    color: #dc2626;
}


/* =========================
   三大專區
========================= */

.category-selector {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 14px;
}


.category-option {

    padding: 20px;

    border:
        2px solid #e2e8f0;

    border-radius: 16px;

    background: white;

    cursor: pointer;

    text-align: center;

    transition: 0.2s;
}


.category-option:hover {

    border-color: #a5b4fc;

    transform: translateY(-2px);
}


.category-option.active {

    border-color: #4f46e5;

    background: #eef2ff;
}


.category-icon {

    font-size: 35px;

    display: block;

    margin-bottom: 8px;
}


.category-name {

    font-weight: 900;

    font-size: 17px;
}


.category-description {

    color: #64748b;

    font-size: 12px;

    margin-top: 5px;
}


/* =========================
   動態設定
========================= */

.dynamic-fields {

    margin-top: 20px;

    padding: 20px;

    background: #f8fafc;

    border-radius: 16px;

    border:
        1px solid #e2e8f0;
}


.dynamic-title {

    font-weight: 900;

    font-size: 17px;

    margin-bottom: 17px;
}


.keyword-help {

    color: #64748b;

    font-size: 12px;
}


/* =========================
   工具列表
========================= */

.tool-list {

    display: grid;

    gap: 12px;
}


.tool-item {

    border:
        1px solid #e2e8f0;

    border-radius: 15px;

    padding: 17px;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 15px;
}


.tool-info {

    display: flex;

    align-items: center;

    gap: 14px;

    min-width: 0;
}


.tool-icon {

    font-size: 36px;

    flex-shrink: 0;
}


.tool-name {

    font-weight: 900;

    font-size: 16px;
}


.tool-meta {

    color: #64748b;

    font-size: 13px;

    margin-top: 5px;
}


.tool-keywords {

    color: #6366f1;

    font-size: 12px;

    margin-top: 4px;
}


.tool-actions {

    display: flex;

    gap: 8px;

    flex-shrink: 0;
}


.edit-btn {

    background: #eef2ff;

    color: #4338ca;

    padding: 9px 13px;

    border-radius: 9px;

    font-weight: 700;
}


.delete-btn {

    background: #fef2f2;

    color: #dc2626;

    padding: 9px 13px;

    border-radius: 9px;

    font-weight: 700;
}


/* =========================
   訊息
========================= */

.message {

    display: none;

    margin-top: 15px;

    padding: 13px 15px;

    border-radius: 10px;

    font-weight: 700;
}


.success {

    background: #dcfce7;

    color: #166534;
}


.error {

    background: #fee2e2;

    color: #991b1b;
}


/* =========================
   手機
========================= */

@media (max-width: 700px) {

    .form-grid {

        grid-template-columns: 1fr;
    }


    .full {

        grid-column: auto;
    }


    .category-selector {

        grid-template-columns: 1fr;
    }


    .header-inner {

        flex-direction: column;

        align-items: flex-start;
    }


    .tool-item {

        flex-direction: column;

        align-items: flex-start;
    }


    .tool-actions {

        width: 100%;
    }


    .tool-actions button {

        flex: 1;
    }

}

</style>

</head>


<body>


<!-- ==================================================
     登入頁面
================================================== -->

<div
    class="login-page"
    id="loginPage"
>

    <div class="login-box">

        <div class="login-icon">
            🤖
        </div>

        <h1>
            AI 教育工具中心
        </h1>

        <p>
            管理員後台
        </p>

        <input
